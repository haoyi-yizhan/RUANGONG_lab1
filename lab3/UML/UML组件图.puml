@startuml
' 实验二：组件图
' 布局按调用方向分四层：顶部四类角色用户 → 对外接口与发起调用的模块 →
' 被依赖的交易(M4，含售票·候补·退款，全局枢纽)与活动发布与审核(M2) → 底部平台支撑(M7)。
' 依赖方向自上而下，全程无交叉。
' 说明1：登录是四类角色共用的入口，抽象为接口画在系统框内、紧贴 M1；
'        下单不设接口——它是 M4 交易模块的内建能力（候补递补复用同一入口），
'        购票链路由 M3 ..> M4 的查询余票依赖表达。
' 说明2：支付是 M4 交易模块的内建职责（REQ-007，站内模拟、不接入真实支付），
'        与订单事务不可分，不单独成组件，图中只有 M1~M7 七个模块、无外部系统。
' 说明3：模块框内第二行小字为该模块的代表性职责（与第2章模块划分对应）。
' 说明4：标记 [hidden] 的锚点边仅用于定位，不表达任何关系。
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 14
skinparam shadowing false
skinparam ArrowColor #4B5563
skinparam BorderColor #7C8AA0
skinparam TitleFontSize 19
skinparam TitleFontColor #334155
skinparam nodesep 30
skinparam ranksep 60
skinparam componentStyle rectangle
skinparam componentBackgroundColor #FFFFFF
skinparam componentBorderColor #7C8AA0
skinparam interfaceBackgroundColor #F2F5F9
skinparam interfaceBorderColor #7C8AA0

title 活动票务与报名系统 · 组件图

package "活动票务与报名系统" {
  component "**账号与权限 (M1)**\n<size:11>注册登录 · 实名认证 · 封禁</size>" as M1
  component "**活动发布与审核 (M2)**\n<size:11>申请受理 · 审核流转</size>" as M2
  component "**查询展示 (M3)**\n<size:11>演出查询 · 余票展示</size>" as M3
  component "**交易 (M4)**\n<size:11>限购校验 · 支付出票 · 候补递补 · 退款</size>" as M4
  component "**检票 (M5)**\n<size:11>票码核验 · 窗口控制</size>" as M5
  component "**统计与导出 (M6)**\n<size:11>场次统计 · 名单导出</size>" as M6
  component "**平台支撑 (M7)**\n<size:11>审计日志 · 站内通知</size>" as M7

  () "登录" as API_LOGIN
}

actor "四类角色用户\n(参与者/组织者/\n检票人员/管理员)" as U

U -down-> API_LOGIN : 注册登录
U -down-> M3 : 查询演出
U -down-> M5 : 核销票码

API_LOGIN -down- M1

M3 ..> M2 : 查询活动
M3 ..> M4 : 查询余票
M6 ..> M4 : 读取售票数据
M5 ..> M4 : 核验票码
M4 ..> M7 : 写审计日志
M2 ..> M7 : 发送站内通知

M1 -[hidden]right- M3
M3 -[hidden]right- M5
M5 -[hidden]right- M6
M3 -[hidden]down- M2
M5 -[hidden]down- M4
M2 -[hidden]right- M4
M4 -[hidden]down- M7
@enduml
