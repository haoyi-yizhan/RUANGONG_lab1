@startuml
' 实验二 类图：活动票务与报名系统（对应 requirements.md REQ-001 ~ REQ-024）
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 70
skinparam packageStyle rectangle
hide circle
hide empty members

package "账号与权限模块" #EEF3FA {
  abstract class 用户 {
    - 账号ID : string
    - 手机号 : string
    - 密码哈希 : string
    - 状态 : 正常/封禁
    + 登录(手机号, 密码) : bool
    + 重置密码() : void
  }
  class 实名信息 {
    - 姓名 : string
    - 身份证号 : string
  }
  class 参与者
  class 组织者
  class 检票人员
  class 平台管理员
  class 封禁记录 {
    - 目标账号 : string
    - 原因 : string
    - 操作时间 : datetime
  }
}

package "活动与票档模块" #EEFAF0 {
  class 活动 {
    - 活动ID : string
    - 名称 : string
    - 类型 : 付费演出/讲座
    - 主演或主讲 : string
    - 状态 : 活动状态
    + 提交申请() : void
    + 申请改期(时间, 地点) : void
    + 申请取消() : void
  }
  class 场次 {
    - 场次ID : string
    - 开始时间 : datetime
    - 地点 : string
    - 报名截止时间 : datetime
    - 签到窗口是否开启 : bool
    + 可售余票() : int
    + 开启签到窗口() : void
  }
  class 票档 {
    - 票档ID : string
    - 名称 : string
    - 价格 : decimal
    - 总量 : int
    - 已售数 : int
    + 可售余票() : int
    + 是否售罄() : bool
    + 扣减() : bool
  }
  class 审核记录 {
    - 轮次 : int
    - 结论 : 通过/驳回
    - 驳回原因 : string
    - 审核时间 : datetime
  }
  enum 活动状态 {
    待审核
    上线
    在售中
    已截止
    检票中
    已结束
    已取消
  }
}

package "交易模块" #FDF6EC {
  class 订单 {
    - 订单ID : string
    - 座位号 : string
    - 票码 : string
    - 实付金额 : decimal
    - 状态 : 订单状态
    - 支付截止时间 : datetime
    + 支付() : bool
    + 出票(座位号, 票码) : void
    + 退票() : decimal
    + 关闭() : void
  }
  class 候补记录 {
    - 排队序号 : int
    - 预付金额 : decimal
    - 状态 : 候补中/已递补/已退款
    + 递补() : 订单
    + 退出() : void
  }
  class 支付记录 {
    - 金额 : decimal
    - 结果 : 成功/失败
    - 支付时间 : datetime
  }
  class 退款 {
    - 退款金额 : decimal
    - 手续费 : decimal
    - 原因 : 退票/活动取消/改期/候补失败
    - 状态 : 处理中/已到账
  }
  enum 订单状态 {
    待支付
    候补中
    已出票
    已签到
    已核销
    已缺席
    已取消
    已关闭
    已退款
  }
}

package "现场与运营模块" #F5EEFB {
  class 检票记录 {
    - 核验时间 : datetime
    - 核验结果 : 放行/重复/无效/未开窗
  }
  class 场次统计 {
    - 出票数 : int
    - 到场人数 : int
    - 候补人数 : int
    - 退票数 : int
    + 上座率() : decimal
  }
}

package "平台支撑模块" #F0F0F0 {
  class 审计日志 {
    - 操作者 : string
    - 操作时间 : datetime
    - 动作 : string
    - 对象 : string
    - 状态前值 : string
    - 状态后值 : string
    + 追加() : void
    + 按对象查询() : list
  }
  class 站内通知 {
    - 标题 : string
    - 内容 : string
    - 是否已读 : bool
  }
}


note bottom of 审计日志 : 所有模块的关键操作统一调用追加()写入\n记录不可删改，可按活动或订单查询（REQ-016）
note bottom of 站内通知 : 由活动改期/取消、候补递补结果触发\n仅面向受影响的购票用户（REQ-010）

' ---------- 继承 ----------
参与者 --|> 用户
组织者 --|> 用户
检票人员 --|> 用户
平台管理员 --|> 用户

' ---------- 账号与权限 ----------
用户 "1" -- "0..1" 实名信息 : 实名绑定 >
平台管理员 "1" -- "*" 封禁记录 : 开具 >

' ---------- 活动与票档 ----------
组织者 "1" -- "*" 活动 : 提交 >
活动 "1" *-- "1..*" 场次
场次 "1" *-- "1..*" 票档
活动 "1" -- "*" 审核记录 : 审核留痕 >
活动 --> 活动状态

' ---------- 交易 ----------
参与者 "1" -- "*" 订单 : 购买 >
票档 "1" -- "*" 订单 : 售出 >
订单 "1" *-- "1" 支付记录
订单 "1" -- "0..1" 退款
订单 --> 订单状态
票档 "1" -- "*" 候补记录 : 同一票档一条队列 >
候补记录 "1" ..> "0..1" 订单 : 递补生成 >

' ---------- 现场与运营 ----------
场次 "1" -- "*" 检票记录 : 签到窗口内核销 >
检票人员 "1" -- "*" 检票记录 : 执行 >
订单 "1" -- "0..1" 检票记录 : 被核验 >
场次 "1" -- "0..1" 场次统计
检票记录 -[hidden]left- 审计日志

@enduml
